local Math=require('../src/plugin/HingeDragMath')
local drag=Math.begin('lower',-30,70,-30)
assert(Math.move(drag,-10)==-10,'lower follows pointer')
assert(Math.move(drag,100)==70,'lower never crosses upper')
assert(Math.move(drag,60)==30,'lower immediately leaves clamp by the reversed pointer delta')
local upper=Math.begin('upper',-170,170,170)
assert(Math.move(upper,-179)==180,'crossing positive 180 clamps, not jumps negative')
assert(Math.move(upper,175)==174,'return from clamp uses the reversed pointer delta')
local lower=Math.begin('lower',-170,170,-170)
assert(Math.move(lower,179)==-180,'crossing negative 180 clamps, not jumps positive')
assert(Math.move(lower,-175)==-174,'return from clamp uses the reversed pointer delta')
local overshootUpper=Math.begin('upper',-90,170,170)
assert(Math.move(overshootUpper,-160)==180,'upper remains bounded at positive 180')
assert(Math.move(overshootUpper,-161)==179,'reversing after a large upper overshoot responds immediately')
local overshootLower=Math.begin('lower',-170,90,-170)
assert(Math.move(overshootLower,160)==-180,'lower remains bounded at negative 180')
assert(Math.move(overshootLower,161)==-179,'reversing after a large lower overshoot responds immediately')
local acrossLower=Math.begin('upper',-20,30,30)
assert(Math.move(acrossLower,-60)==-20,'upper stops at the lower bound')
assert(Math.move(acrossLower,-59)==-19,'upper reverses immediately from the lower bound')
assert(not pcall(function() Math.begin('lower',40,-40,0) end),'invalid range rejected')
assert(not pcall(function() Math.move(lower,0/0) end),'nonfinite angle rejected')
print('Hinge draft drag math passed')

local StepTrajectory=require('../src/runtime/StepTrajectory')
local function near(a,b) assert(math.abs(a-b)<1e-8,tostring(a)..' ~= '..tostring(b)) end
local trajectory=StepTrajectory.new({start={1,0,0},target={3,0,0},up={0,2,0},height=1,duration=2})
local p,done,t=trajectory:sample(0)
near(p[1],1); near(p[2],0); assert(not done and t==0)
p,done,t=trajectory:advance(1)
near(p[1],2); near(p[2],1); assert(not done and t==0.5)
p,done,t=trajectory:advance(10)
near(p[1],3); near(p[2],0); assert(done and t==1)
p=trajectory:advance(1); near(p[1],3)
local split=StepTrajectory.new({start={1,0,0},target={3,0,0},up={0,1,0},height=1,duration=2})
split:advance(.25); local intermediate=split:advance(.75)
local reference=trajectory:sample(1)
near(intermediate[1],reference[1]); near(intermediate[2],reference[2])
local before=split:sample(0.00001); local after=split:sample(1.99999)
assert(before[2]<1e-8 and after[2]<1e-8,'lift should have zero endpoint velocity')
assert(not pcall(function() split:advance(-1) end))
assert(not pcall(function() StepTrajectory.new({start={0,0,0},target={1,0,0},up={0,0,0},height=1,duration=1}) end))
assert(not pcall(function() StepTrajectory.new({start={0,0,0},target={1,0,0},up={0,1,0},height=-1,duration=1}) end))
assert(not pcall(function() StepTrajectory.new({start={0,0,0},target={1,0,0},up={0,1,0},height=1,duration=0}) end))
print('step trajectory tests passed')

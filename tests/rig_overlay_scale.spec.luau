local RigOverlay=require('../src/plugin/RigOverlay')
local near=RigOverlay.radiusFromProjection(70,false)
local far=RigOverlay.radiusFromProjection(35,false)
assert(math.abs(far/near-2)<1e-6,'unclamped marker radius must scale with camera depth')
assert(RigOverlay.radiusFromProjection(70,true)>near,'selection must also be identified by marker size')
assert(RigOverlay.radiusFromProjection(100000,false)>=.04,'near markers must retain a usable size')
assert(RigOverlay.radiusFromProjection(.001,false)<=.4,'distant markers must not obscure the rig')
assert(RigOverlay.radiusFromProjection(0,false)==.16,'invalid projection has a safe fallback')
assert(math.abs(RigOverlay.radiusFromProjection(70,false)-.1)<1e-6,'projection scales markers in either camera mode')
assert(RigOverlay.radiusFromProjection(math.huge,false)==.16,'nonfinite projected dimensions use a safe fallback')
print('rig overlay marker scaling passed')

local Policy=require('../src/plugin/OverlaySelection')
assert(not Policy.showLimit('unconfigured') and not Policy.showLimit('invalidSaved') and not Policy.showLimit('invalid'),'unknown limits must not render fallback values')
assert(Policy.showLimit('saved') and Policy.showLimit('draft'),'valid saved or visibly edited limits can render')
local state=Policy.new()
local rig,joint,other={}, {}, {}
local a,b=state:update(true,true,rig,rig,nil)
assert(a==rig and b==nil,'model selection shows its rig')
a,b=state:update(true,true,joint,rig,joint)
assert(a==rig and b==joint,'selecting a joint keeps its parent rig and shows its guide')
state:hideOverlay(); state:hideAxes()
a,b=state:update(true,true,joint,rig,joint)
assert(a==nil and b==nil,'manual hides persist while selection is unchanged')
a,b=state:update(true,true,other,rig,other)
assert(a==rig and b==other,'a different selection restores automatic displays')
state:hideOverlay()
state:update(false,true,other,rig,other)
a,b=state:update(true,true,other,rig,other)
assert(a==rig and b==other,'reopening clears manual suppression')
a,b=state:update(true,false,other,rig,other)
assert(a==nil and b==nil,'no adornments during Play')
a,b=state:update(true,true,nil,nil,nil)
assert(a==nil and b==nil,'unsupported or multiple selection has no adornments')
state:showOverlay(); state:showAxes()
print('overlay selection lifecycle passed')

local model=Instance.new('Model')
local part=Instance.new('Part'); part.Parent=model
local motor=Instance.new('Motor6D'); motor.Name='Jaw'; motor.Parent=part
local bone=Instance.new('Bone'); bone.Name='Tail'; bone.Parent=part
local function set(joint,kind,axis)
 joint:SetAttribute('EditRigIK_SchemaVersion',1); joint:SetAttribute('EditRigIK_Kind',kind)
 joint:SetAttribute('EditRigIK_Axis',axis); joint:SetAttribute('EditRigIK_LowerDegrees',-45)
 joint:SetAttribute('EditRigIK_UpperDegrees',90); joint:SetAttribute('EditRigIK_SwingDegrees',45)
end
set(motor,'Hinge','Y'); set(bone,'Hinge','Z')
local builder=DefinitionBuilder.new(Config)
local definition=builder.create(model)
assert(definition.Parent==nil and #definition:GetChildren()==2)
assert(definition.Jaw.Value==motor and definition.Jaw:GetAttribute('Control')=='Jaw')
assert(definition.Tail.Value==bone and definition.Tail:GetAttribute('UpperDegrees')==90)
motor:SetAttribute('EditRigIK_Control','Bite')
motor:SetAttribute('EditRigIK_Impulse','Snap')
motor:SetAttribute('EditRigIK_Frequency',8)
bone:SetAttribute('EditRigIK_Control','Bite')
local custom=builder.create(model)
assert(custom.Jaw:GetAttribute('Control')=='Bite' and custom.Jaw:GetAttribute('Impulse')=='Snap' and custom.Jaw:GetAttribute('Frequency')==8,'Motor6D mapping must be preserved')
assert(custom.Tail:GetAttribute('Control')=='Bite','multiple joints can share a control')
assert(custom.Tail:GetAttribute('Impulse')=='TailImpulse' and custom.Tail:GetAttribute('Frequency')==4,'unspecified values use defaults')
definition.Parent=model
builder.refresh(definition)
assert(definition.Jaw:GetAttribute('Control')=='Bite' and definition.Jaw:GetAttribute('Frequency')==8,'refresh should update Motor6D mapping')
assert(definition.Tail:GetAttribute('Control')=='Bite' and definition.Tail.Value==bone,'refresh should update Bone and preserve reference')
motor:SetAttribute('EditRigIK_Frequency',6)
bone:SetAttribute('EditRigIK_Frequency',0)
assert(not pcall(function() builder.refresh(definition) end),'invalid later binding must reject refresh')
assert(definition.Jaw:GetAttribute('Frequency')==8,'failed refresh must not partially update earlier bindings')
bone:SetAttribute('EditRigIK_Frequency',4)
motor:SetAttribute('EditRigIK_Control',string.rep('x',129))
assert(not pcall(function() builder.create(model) end),'unusable control names must be rejected')
custom:Destroy()
set(bone,'Ball','Z')
assert(not pcall(function() builder.create(model) end),'unsupported ball limits must not silently degrade')
definition:Destroy(); model:Destroy()
return 'Definition builder validated Motor6D and Bone configuration'

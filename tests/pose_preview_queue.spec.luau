local Queue=require('../src/plugin/PosePreviewQueue')
local queue=Queue.new(3)
assert(queue:next()==nil,'an idle queue has no work')
local target={1,2,3}; local orientation={0,0,0,1}
queue:request(target,orientation)
assert(not queue:complete(nil,{converged=true}), 'only a previously dispatched job may complete')
local first=queue:next()
assert(first.target==target and first.orientation==orientation and first.iteration==1 and first.previous==nil,'first job captures the requested pose')
assert(queue:next()==nil,'a job may not be scheduled twice while in flight')
local firstResult={converged=false,rotations={{0,0,0,1}},error=1}
local accepted,status=queue:complete(first,firstResult)
assert(accepted and status=='pending','a valid incomplete result schedules the next iteration')
local second=queue:next()
assert(second.iteration==2 and second.previous==firstResult,'a job receives the previous pose for warm starting')
queue:request('new-target','new-orientation')
assert(not queue:complete(second,{converged=true}),'an old result must never publish after replacement')
local replacement=queue:next()
assert(replacement.target=='new-target' and replacement.iteration==1 and replacement.previous==nil,'a new request restarts the iteration budget')
assert(queue:complete(replacement,{converged=true}),'a converged current result publishes')
assert(queue:next()==nil,'converged work terminates')
queue:request(target,orientation)
local a=queue:next(); assert(queue:complete(a,{converged=false}))
local b=queue:next(); assert(queue:complete(b,{converged=false}))
local c=queue:next(); local ok,limit=queue:complete(c,{converged=false})
assert(ok and limit=='exhausted' and queue:next()==nil,'iteration budget is strictly bounded')
queue:request(target,orientation)
local failing=queue:next(); local published,failed=queue:complete(failing,nil)
assert(not published and failed=='failed' and queue:next()==nil,'a failed solve terminates without publishing')
queue:request(target,orientation)
local cancelled=queue:next(); queue:cancel()
assert(not queue:complete(cancelled,{converged=true}) and queue:next()==nil,'cancel invalidates in-flight work')
assert(not pcall(function() Queue.new(41) end),'preview cap cannot exceed 40 iterations')
print('pose preview queue tests passed')

local Policy=require('../src/plugin/ViewportInputPolicy')
local p=Policy.new()
assert(not p:update(false,true,true), 'closed panel never claims input')
assert(p:update(true,true,true), 'open panel pre-arms input for eligible rig')
assert(p:update(true,true,true), 'moving from model to joint keeps input')
p:toolTakenOver()
assert(not p:update(true,true,true), 'another Studio tool stays in control')
assert(not p:update(true,true,false) and not p:update(true,true,true), 'selection changes do not steal control back')
p:resume()
assert(p:update(true,true,true), 'explicit resume reclaims input')
assert(not p:update(true,false,true), 'Play mode releases input')
assert(p:update(true,true,true), 'return to Edit can re-arm when not suppressed')
p:toolTakenOver()
assert(not p:update(false,true,true), 'closing the panel releases input')
assert(p:update(true,true,true), 'reopening the panel re-arms input')
assert(not p:update(true,true,false), 'no eligible overlay releases input')
print('Viewport input ownership policy passed')
